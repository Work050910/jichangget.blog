---
import type { TocItem } from "@/utils/generateToc";

interface Props {
	heading: TocItem;
}

const {
	heading: { children, depth, slug, text },
} = Astro.props;
---

<li class={`${depth > 2 ? "ms-3 text-muted" : "font-medium text-global-text"}`}>
	<a
		class={`line-clamp-2 py-1 block hover:text-accent hover:underline transition ${depth <= 2 ? "text-xs text-global-text" : "text-[11px] text-muted"}`}
		href={`#${slug}`}
	>
		{text}
	</a>
	{
		!!children.length && (
			<ol class="ms-2 border-l border-border/60 pl-2 space-y-1 my-1">
				{children.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ol>
		)
	}
</li>
