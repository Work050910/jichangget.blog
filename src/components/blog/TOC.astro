---
import type { MarkdownHeading } from "astro";
import { generateToc } from "@/utils/generateToc";
import TOCHeading from "./TOCHeading.astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const toc = generateToc(headings);
---

<details open class="lg:sticky lg:top-8 w-full lg:w-72 lg:shrink-0 rounded-xl border border-border bg-card p-4 shadow-sm">
	<summary class="font-bold text-sm text-accent-2 hover:text-accent cursor-pointer flex items-center justify-between select-none">
		<span>📑 本文目录</span>
		<span class="text-[11px] text-muted font-normal">点击折叠</span>
	</summary>
	<nav class="mt-3 text-xs">
		<ol class="space-y-1">
			{toc.map((heading) => <TOCHeading heading={heading} />)}
		</ol>
	</nav>
</details>
