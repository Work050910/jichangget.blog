---
import { type CollectionEntry } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const allPosts = await getAllPosts();
const stablePosts = allPosts
	.filter((p) => p.data.tags.includes("稳定机场"))
	.sort(collectionDateSort) as CollectionEntry<"post">[];
---

<PageLayout
	meta={{
		title: "稳定机场｜稳定机场评估准则与维护信息核对",
		description: "拒绝虚假绝对稳定承诺，基于 IPLC 专线拓扑、多入口容灾调度、晚高峰容忍阈值及官方维护公告透明度，客观建立稳定机场评估框架。",
	}}
>
	<header class="mb-10 border-b border-border pb-6">
		<div class="inline-block rounded-full bg-accent/15 px-3 py-1 text-xs font-semibold text-accent mb-2">
			🛡️ 稳定性客观评估
		</div>
		<h1 class="text-2xl font-bold tracking-tight text-accent-2 sm:text-3xl mb-3">
			稳定机场：专线架构、容灾调度与服务规则深度核验
		</h1>
		<p class="text-xs text-muted leading-relaxed">
			本栏目恪守专业中立原则：“稳定机场”只能用于服务规则、节点资料、维护说明和购买前核对的评估方向；不得承诺永久稳定、永不掉线或保证可用。全站收录的 28 家机场架构档案请进入
			<a href="/airport-recommend/" class="text-accent underline font-semibold">机场推荐核心主页</a> 查阅。
		</p>
	</header>

	<section class="mb-10 rounded-xl border border-border bg-card p-5 shadow-sm">
		<h2 class="text-sm font-bold text-accent-2 mb-2">🔍 稳定机场评估的工程定义与标准</h2>
		<p class="text-xs text-muted leading-relaxed">
			具备分布式多入口容灾 + 晚高峰可预测的时延波动 + 规范透明的维护公告发布机制 + 严格的邻居合理使用守则。
		</p>
	</section>

	<section class="mb-12">
		<h2 class="text-lg font-bold text-accent-2 mb-6 flex items-center justify-between">
			<span>📚 稳定机场深度专栏 ({stablePosts.length})</span>
			<span class="text-xs text-muted">包含 14 篇评估长文</span>
		</h2>
		<ul class="space-y-4" role="list">
			{
				stablePosts.map((p) => (
					<li class="grid gap-1 sm:grid-cols-[auto_1fr] border-b border-border/40 pb-3">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>
