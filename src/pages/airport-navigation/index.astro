---
import { type CollectionEntry } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const allPosts = await getAllPosts();
const navPosts = allPosts
	.filter((p) => p.data.tags.includes("机场导航"))
	.sort(collectionDateSort) as CollectionEntry<"post">[];
---

<PageLayout
	meta={{
		title: "机场导航｜机场导航入口与分类指引",
		description: "机场导航频道系统整理了按预算、业务需求、线路架构及流量档位筛选机场梯子的方法。所有导航均以 /airport-recommend/ 核心聚合主页为基准。",
	}}
>
	<header class="mb-10 border-b border-border pb-6">
		<div class="inline-block rounded-full bg-accent/15 px-3 py-1 text-xs font-semibold text-accent mb-2">
			🧭 导航索引频道
		</div>
		<h1 class="text-2xl font-bold tracking-tight text-accent-2 sm:text-3xl mb-3">
			机场导航：按需求与预算快速查找机场推荐与机场梯子资料
		</h1>
		<p class="text-xs text-muted leading-relaxed">
			本频道收录了关于机场导航使用方法、参数对比维度、分类筛选技巧及虚假宣传防范的深度指南。无论您是初次接触网络梯子的新手，还是需要高带宽低延迟专线的资深用户，均可从本栏目中找到清晰的筛选路径。所有机场详细参数均回链至
			<a href="/airport-recommend/" class="text-accent underline font-semibold">机场推荐核心主页</a>。
		</p>
	</header>

	<section class="mb-10 rounded-xl border border-border bg-card p-5 shadow-sm">
		<h2 class="text-sm font-bold text-accent-2 mb-2">🚀 机场推荐核心导航快速直达</h2>
		<p class="text-xs text-muted mb-3">
			如果您希望直接查看全站已收录的 28 家机场价格与优惠码横向对比表，请直接进入核心聚合专页：
		</p>
		<a
			href="/airport-recommend/"
			class="inline-block rounded-lg bg-accent px-4 py-2 text-xs font-bold text-global-bg hover:opacity-90 transition"
		>
			进入机场推荐总览页（28 家机场卡片） &rarr;
		</a>
	</section>

	<section class="mb-12">
		<h2 class="text-lg font-bold text-accent-2 mb-6 flex items-center justify-between">
			<span>📚 机场导航与机场推荐精选指南 ({navPosts.length})</span>
			<span class="text-xs text-muted">包含 12 篇独立指南</span>
		</h2>
		<ul class="space-y-4" role="list">
			{
				navPosts.map((p) => (
					<li class="grid gap-1 sm:grid-cols-[auto_1fr] border-b border-border/40 pb-3">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>
